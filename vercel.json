{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/trinetra_v2/command_center.html" },
    { "source": "/command_center", "destination": "/trinetra_v2/command_center.html" },
    { "source": "/command_center.html", "destination": "/trinetra_v2/command_center.html" },
    { "source": "/overview", "destination": "/trinetra_v2/index.html" },
    { "source": "/overview.html", "destination": "/trinetra_v2/index.html" },
    { "source": "/specs", "destination": "/trinetra_v2/index.html" },
    { "source": "/index.html", "destination": "/trinetra_v2/index.html" },
    { "source": "/css/(.*)", "destination": "/trinetra_v2/css/$1" },
    { "source": "/js/(.*)", "destination": "/trinetra_v2/js/$1" },
    { "source": "/assets/(.*)", "destination": "/trinetra_v2/assets/$1" },
    { "source": "/trinetra_v2/(.*)", "destination": "/trinetra_v2/$1" }
  ]
}
